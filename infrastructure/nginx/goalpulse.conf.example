# Host Nginx configuration for GoalPulse. Nginx is intentionally not a container.
# Replace goalpulse.example.com before enabling this file.

map $http_upgrade $goalpulse_connection_upgrade {
    default upgrade;
    ''      close;
}

upstream goalpulse_frontend {
    server 127.0.0.1:3000;
    keepalive 16;
}

upstream goalpulse_gateway {
    server 127.0.0.1:8000;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name goalpulse.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name goalpulse.example.com;

    # Certbot creates these files. Follow docs/phase2/VPS-DEPLOYMENT.md before
    # enabling this final TLS server block on a new host.
    ssl_certificate /etc/letsencrypt/live/goalpulse.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/goalpulse.example.com/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:GoalPulseTLS:10m;
    ssl_session_tickets off;

    client_max_body_size 64k;
    server_tokens off;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;

    location ~ ^/(v1|v2|health)(/|$) {
        proxy_pass http://goalpulse_gateway;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }

    location / {
        proxy_pass http://goalpulse_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $goalpulse_connection_upgrade;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
