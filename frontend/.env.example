# Copy to .env.local. Values are inlined into the browser bundle at build time: no secrets here.
# All three are required; there are no defaults (R2-D2-02). `next dev` / `next build` stop on a bad value.
#
# NEXT_PUBLIC_GOALPULSE_PROFILE: test | dev | demo   (demo only runs against the real gateway)
# NEXT_PUBLIC_API_MODE:          mock    = recorded Goal Intelligence conversations, no backend, labelled "Mock mode"
#                                gateway = real public gateway, demo sign-in with an HttpOnly cookie
# NEXT_PUBLIC_GATEWAY_URL:       origin of the public gateway (gateway mode only)

# Local UI work without a backend:
NEXT_PUBLIC_GOALPULSE_PROFILE=dev
NEXT_PUBLIC_API_MODE=mock

# Demo against the real stack (comment the two lines above, uncomment these):
# NEXT_PUBLIC_GOALPULSE_PROFILE=demo
# NEXT_PUBLIC_API_MODE=gateway
# NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000
