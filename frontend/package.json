{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.6 <23"
  },
  "scripts": {
    "predev": "node scripts/check-node.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/check-node.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pretypecheck": "node scripts/check-node.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "pretest": "node scripts/check-node.mjs",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.ts",
    "pree2e": "node scripts/check-node.mjs",
    "e2e": "playwright test --project=chromium",
    "predemo": "node scripts/check-node.mjs",
    "demo": "playwright test --project=demo --reporter=list && node e2e/collect-demo.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "typescript": "^5"
  }
}
