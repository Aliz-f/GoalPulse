# GoalPulse centralized runtime configuration
# Run `python3 infrastructure/release/manage_env.py` to create or repair .env.
# Every variable has a description and accepted values for operators and tooling.
# Never commit .env or real credentials. Defaults target the VPS demo profile.

# -----------------------------------------------------------------------------
# Deployment identity and host-published loopback ports
# -----------------------------------------------------------------------------
# Description: Stable Docker Compose project name used to name containers, networks, and volumes.
# Options: Lowercase letters, digits, hyphens, or underscores; recommended `goalpulse`.
COMPOSE_PROJECT_NAME=goalpulse
# Description: Runtime safety profile shared by Gateway and all services.
# Options: `test`, `dev`, or `demo`; VPS MVP presentations use `demo`.
GOALPULSE_PROFILE=demo
# Description: Loopback host port where Nginx reaches the Next.js frontend.
# Options: Any unused integer from 1 to 65535; recommended `3000`.
FRONTEND_HOST_PORT=3000
# Description: Loopback host port where Nginx reaches the public Gateway.
# Options: Any unused integer from 1 to 65535; recommended `8000`.
GATEWAY_HOST_PORT=8000
# Description: Loopback host port for PostgreSQL operator access.
# Options: Any unused integer from 1 to 65535; recommended `5432`.
POSTGRES_HOST_PORT=5432
# Description: Loopback host port for RabbitMQ AMQP operator access.
# Options: Any unused integer from 1 to 65535; recommended `5672`.
RABBITMQ_HOST_PORT=5672
# Description: Loopback host port for the RabbitMQ management UI.
# Options: Any unused integer from 1 to 65535; recommended `15672`.
RABBITMQ_MANAGEMENT_HOST_PORT=15672

# -----------------------------------------------------------------------------
# Frontend (compiled into the browser bundle; these values are public)
# -----------------------------------------------------------------------------
# Description: Selects whether the browser uses recorded mock data or the public Gateway.
# Options: `mock` for test/dev only, or `gateway`; demo requires `gateway`.
NEXT_PUBLIC_API_MODE=gateway
# Description: Public Gateway origin compiled into the frontend; must match the demo allowed origin.
# Options: One HTTP(S) origin without a path; HTTPS is required for demo, blank is allowed in mock mode.
NEXT_PUBLIC_GATEWAY_URL=https://CHANGE_ME.example.com

# -----------------------------------------------------------------------------
# PostgreSQL bootstrap and service-owned databases
# Changing these after the database volume exists does not rotate DB passwords.
# -----------------------------------------------------------------------------
# Description: PostgreSQL bootstrap administrator used only for initialization and operator backups.
# Options: Valid PostgreSQL role name; recommended `goalpulse_admin`.
POSTGRES_USER=goalpulse_admin
# Description: PostgreSQL bootstrap administrator password.
# Options: Unique URL-safe secret with at least 32 characters; the manager can generate it.
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_ADMIN_PASSWORD
# Description: PostgreSQL maintenance database selected during bootstrap and health checks.
# Options: `postgres`.
POSTGRES_DB=postgres
# Description: Password for the Goal Intelligence-owned PostgreSQL role.
# Options: Unique URL-safe secret with at least 32 characters; the manager can generate it.
GOAL_INTELLIGENCE_DB_PASSWORD=CHANGE_ME_GOAL_INTELLIGENCE_DB_PASSWORD
# Description: Password for the Goal Management-owned PostgreSQL role.
# Options: Unique URL-safe secret with at least 32 characters; the manager can generate it.
GOAL_MANAGEMENT_DB_PASSWORD=CHANGE_ME_GOAL_MANAGEMENT_DB_PASSWORD
# Description: Password for the Discovery Monitoring-owned PostgreSQL role.
# Options: Unique URL-safe secret with at least 32 characters; the manager can generate it.
DISCOVERY_MONITORING_DB_PASSWORD=CHANGE_ME_DISCOVERY_MONITORING_DB_PASSWORD
# Description: Password for the Data and Evidence-owned PostgreSQL role.
# Options: Unique URL-safe secret with at least 32 characters; the manager can generate it.
DATA_EVIDENCE_DB_PASSWORD=CHANGE_ME_DATA_EVIDENCE_DB_PASSWORD
# Description: Password for the Goal Evaluation-owned PostgreSQL role.
# Options: Unique URL-safe secret with at least 32 characters; the manager can generate it.
GOAL_EVALUATION_DB_PASSWORD=CHANGE_ME_GOAL_EVALUATION_DB_PASSWORD
# Description: Password for the Notification-owned PostgreSQL role.
# Options: Unique URL-safe secret with at least 32 characters; the manager can generate it.
NOTIFICATION_DB_PASSWORD=CHANGE_ME_NOTIFICATION_DB_PASSWORD
# Description: Password for the Agent Integration-owned PostgreSQL role.
# Options: Unique URL-safe secret with at least 32 characters; the manager can generate it.
AGENT_INTEGRATION_DB_PASSWORD=CHANGE_ME_AGENT_INTEGRATION_DB_PASSWORD

# -----------------------------------------------------------------------------
# RabbitMQ
# Changing these after the broker volume exists does not rotate broker users.
# -----------------------------------------------------------------------------
# Description: RabbitMQ application/bootstrap username.
# Options: Nonempty broker username without whitespace; recommended `goalpulse`.
RABBITMQ_DEFAULT_USER=goalpulse
# Description: RabbitMQ application/bootstrap password.
# Options: Unique URL-safe secret with at least 32 characters; the manager can generate it.
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RABBITMQ_PASSWORD

# -----------------------------------------------------------------------------
# Gateway authentication, internal service identity, and demo users
# -----------------------------------------------------------------------------
# Description: HS256 secret for development user JWT validation and Goal Management ownership checks.
# Options: Unique secret with at least 32 characters; the manager can generate it.
GATEWAY_DEV_JWT_SECRET=CHANGE_ME_GATEWAY_JWT_SECRET_AT_LEAST_32_CHARS
# Description: Required issuer claim for development user JWTs.
# Options: Any stable nonempty identifier; recommended `goalpulse-demo` for demo.
GATEWAY_JWT_ISSUER=goalpulse-demo
# Description: Required audience claim for public GoalPulse JWTs.
# Options: Any stable nonempty identifier; recommended `goalpulse-api`.
GATEWAY_JWT_AUDIENCE=goalpulse-api
# Description: Shared HS256 secret used to authenticate private service-to-service requests.
# Options: Unique secret with at least 32 characters; the manager can generate it.
SERVICE_JWT_SECRET=CHANGE_ME_SERVICE_JWT_SECRET_AT_LEAST_32_CHARS
# Description: Required issuer claim for private service JWTs.
# Options: Any stable nonempty identifier; recommended `goalpulse-internal-demo`.
SERVICE_JWT_ISSUER=goalpulse-internal-demo
# Description: Required audience claim for private service JWTs.
# Options: Any stable nonempty identifier; recommended `goalpulse-internal`.
SERVICE_JWT_AUDIENCE=goalpulse-internal
# Description: Exact browser origin allowed to use demo cookie authentication.
# Options: One HTTP(S) origin without a path; demo requires the same HTTPS value as NEXT_PUBLIC_GATEWAY_URL.
GATEWAY_DEMO_ALLOWED_ORIGIN=https://CHANGE_ME.example.com
# Description: Signing secret for HttpOnly demo session cookies.
# Options: Unique secret with at least 32 characters; required in demo and generatable by the manager.
GATEWAY_DEMO_SESSION_SECRET=CHANGE_ME_SESSION_SECRET_AT_LEAST_32_CHARS
# Description: Lifetime of demo sessions in seconds.
# Options: Integer from 300 to 3600; recommended `1800`.
GATEWAY_DEMO_SESSION_TTL_SECONDS=1800
# Description: Immutable owner UUID for demo user A.
# Options: UUID v4; required in demo and generatable by the manager.
GATEWAY_DEMO_USER_A_ID=CHANGE_ME_UUID
# Description: Sign-in username for demo user A.
# Options: Nonempty unique username; recommended `developer1`.
GATEWAY_DEMO_USER_A_USERNAME=developer1
# Description: PBKDF2-SHA256 password hash for demo user A; plaintext is never stored.
# Options: `pbkdf2_sha256$...` with at least 210000 iterations; the manager can create it interactively.
GATEWAY_DEMO_USER_A_PASSWORD_HASH=CHANGE_ME_PBKDF2_HASH
# Description: Display label shown for demo user A.
# Options: Any nonempty display name.
GATEWAY_DEMO_USER_A_DISPLAY_NAME=Developer 1
# Description: Immutable owner UUID for demo user B.
# Options: UUID v4 distinct from user A; required in demo and generatable by the manager.
GATEWAY_DEMO_USER_B_ID=CHANGE_ME_UUID
# Description: Sign-in username for demo user B.
# Options: Nonempty username distinct from user A; recommended `reviewer`.
GATEWAY_DEMO_USER_B_USERNAME=reviewer
# Description: PBKDF2-SHA256 password hash for demo user B; plaintext is never stored.
# Options: `pbkdf2_sha256$...` with at least 210000 iterations; the manager can create it interactively.
GATEWAY_DEMO_USER_B_PASSWORD_HASH=CHANGE_ME_PBKDF2_HASH
# Description: Display label shown for demo user B.
# Options: Any nonempty display name.
GATEWAY_DEMO_USER_B_DISPLAY_NAME=Reviewer

# -----------------------------------------------------------------------------
# Goal Intelligence / Anthropic
# -----------------------------------------------------------------------------
# Description: LLM extractor implementation used by Goal Intelligence.
# Options: `anthropic`, or `fixture` in test/dev only; demo requires `anthropic`.
GI_LLM_PROVIDER=anthropic
# Description: Anthropic model ID that the deployment account is entitled to use.
# Options: Provider-issued model ID; required when GI_LLM_PROVIDER is `anthropic`.
GI_LLM_MODEL=CHANGE_ME_APPROVED_ANTHROPIC_MODEL_ID
# Description: Optional Anthropic effort hint for models that support it.
# Options: Blank, `low`, `medium`, or `high`.
GI_LLM_EFFORT=
# Description: Timeout for one LLM extraction attempt, in seconds.
# Options: Number from 1 to 120; recommended `20`.
GI_LLM_TIMEOUT_S=20
# Description: Maximum bounded attempts for transient LLM failures.
# Options: Integer from 1 to 5; recommended `3`.
GI_LLM_MAX_ATTEMPTS=3
# Description: Maximum characters accepted in one user message.
# Options: Positive integer; recommended `2000`.
GI_MAX_MESSAGE_CHARS=2000
# Description: Maximum user turns allowed in one clarification session.
# Options: Positive integer; recommended `20`.
GI_MAX_USER_TURNS=20
# Description: Server-side Anthropic API credential used only by Goal Intelligence.
# Options: Nonempty Anthropic API key; required for `anthropic`, entered with hidden input.
ANTHROPIC_API_KEY=CHANGE_ME_ANTHROPIC_API_KEY

# -----------------------------------------------------------------------------
# Goal Management
# -----------------------------------------------------------------------------
# Description: Timeout for authenticated Goal Management internal HTTP calls, in seconds.
# Options: Number from 0.1 to 30; recommended `5`.
GOAL_MANAGEMENT_INTERNAL_TIMEOUT_SECONDS=5

# -----------------------------------------------------------------------------
# Discovery Monitoring / Context.dev
# -----------------------------------------------------------------------------
# Description: External discovery provider selected by Discovery Monitoring.
# Options: `context_dev`.
DM_PROVIDER=context_dev
# Description: Server-side Context.dev API credential used only by Discovery Monitoring.
# Options: Nonempty Context.dev API key without whitespace; entered with hidden input.
CONTEXT_DEV_API_KEY=CHANGE_ME_CONTEXT_DEV_API_KEY
# Description: Outbound Context.dev access policies applied to discovery requests.
# Options: One to 16 provider-issued `pol_...` IDs separated by commas; required in demo, blank allowed in test/dev.
CONTEXT_DEV_ACCESS_POLICY_IDS=CHANGE_ME_CONTEXT_DEV_POLICY_ID
# Description: Maximum simultaneously active monitored goals per user.
# Options: Integer from 1 to 2; recommended `2`.
DM_MAX_ACTIVE_GOALS_PER_USER=2
# Description: Maximum discovery sources registered for one goal.
# Options: Integer from 1 to 3; recommended `3`.
DM_MAX_SOURCES_PER_GOAL=3
# Description: Maximum provider operations allowed for one initial discovery plan.
# Options: Integer from 1 to 100; recommended `100`.
DM_INITIAL_MAX_OPERATIONS_PER_DAY=100
# Description: Maximum discovery provider requests allowed per user per day.
# Options: Integer from 1 to 100; recommended `100`.
DM_MAX_REQUESTS_PER_USER_PER_DAY=100
# Description: Optional comma-separated user UUIDs allowed to run local Discovery operator commands.
# Options: Blank, or comma-separated UUIDs; does not grant browser/API ownership.
DM_OPERATOR_IDS=

# -----------------------------------------------------------------------------
# Data & Evidence
# -----------------------------------------------------------------------------
# Description: Selects real source checking versus test-only fixture evidence.
# Options: `real`; `fixture` is allowed only in explicitly isolated tests.
DE_EVIDENCE_MODE=real
# Description: Evidence provider disclosure checked by Gateway demo startup.
# Options: `real`; demo refuses `fixture`.
DE_EVIDENCE_PROVIDER=real
# Description: Explicit safety switch controlling fixture evidence use.
# Options: `false` for dev/demo runtime; `true` only in isolated tests.
DE_ALLOW_FIXTURE=false
# Description: Merchant domains Data and Evidence is permitted to verify.
# Options: Comma-separated public hostnames without schemes, ports, paths, wildcards, or private addresses.
DE_MERCHANT_HOSTS=CHANGE_ME.example.com

# -----------------------------------------------------------------------------
# Notification
# -----------------------------------------------------------------------------
# Description: Minimum interval between notifications for the same goal, in minutes.
# Options: Integer from 60 to 1440; recommended `60`.
NOTIFY_GOAL_RATE_LIMIT_MINUTES=60
