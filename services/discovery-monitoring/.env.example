# Replace the placeholder in your local .env file. Never commit the real key.
CONTEXT_DEV_API_KEY=replace_with_your_context_dev_api_key

# Runtime settings below must be exported/injected by D1's process configuration.
# Only CONTEXT_DEV_API_KEY is automatically read from this local .env file.
# No service addresses or credentials are supplied by this example.
GOALPULSE_PROFILE=dev
DISCOVERY_MONITORING_DATABASE_URL=
RABBITMQ_URL=
GOAL_MANAGEMENT_BASE_URL=
DATA_EVIDENCE_BASE_URL=
DISCOVERY_SERVICE_ID=
SERVICE_JWT_SECRET=
SERVICE_JWT_ISSUER=
SERVICE_JWT_AUDIENCE=
DM_MAX_SOURCES_PER_GOAL=3
DM_INITIAL_MAX_OPERATIONS_PER_DAY=100
DM_MAX_ACTIVE_GOALS_PER_USER=2
DM_MAX_REQUESTS_PER_USER_PER_DAY=100
# Trusted deployment allowlist, not a caller-supplied role or username.
# Windows: sid:<OS token SID>; POSIX: uid:<effective numeric UID>. Empty denies.
DM_OPERATOR_IDS=
